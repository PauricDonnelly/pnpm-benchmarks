{
  "name": "notarial-marriage-frontend",
  "version": "1.0.0",
  "description": "Notarial frontend application to enable UK nationals to get married abroad",
  "type": "module",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": "24.x"
  },
  "main": "src/app.js",
  "author": "FCDO",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "format:js": "biome format --write .",
    "format:gherkin": "prettier --write --plugin prettier-plugin-gherkin **/*.feature",
    "format:nunjucks": "prettier --write --plugin prettier-plugin-nunjucks **/*.njk",
    "format": "pnpm format:js && pnpm format:nunjucks && pnpm format:gherkin",
    "lint": "biome lint --write .",
    "assist": "biome check --formatter-enabled=false --linter-enabled=false --write .",
    "quality": "pnpm format && pnpm lint && pnpm assist",
    "security": "pnpm audit --audit-level=moderate",
    "test:unit": "vitest run --coverage",
    "test:unit:report": "pnpm test:unit && open-cli coverage/index.html",
    "chromedriver:install": "playwright install chromium",
    "test:component:runner": "bddgen --config playwright-cucumber.config.js && playwright test --config playwright-cucumber.config.js",
    "test:component": "node scripts/run-component-tests.js pnpm test:component:runner",
    "test:component:headed": "pnpm test:component -- -- --headed",
    "test": "pnpm test:unit && pnpm test:component",
    "build:sass": "shx mkdir -p src/public/stylesheets && sass --quiet --load-path . --style compressed --no-source-map src/assets/stylesheets/app.scss src/public/stylesheets/application.css",
    "build:js": "shx mkdir -p src/public/javascripts && rollup --silent -c",
    "build": "shx rm -rf ./src/public && pnpm build:sass && pnpm build:js",
    "start": "node src/app.js"
  },
  "dependencies": {
    "@x-govuk/govuk-prototype-components": "^6.0.0",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "form-data": "^4.0.6",
    "govuk-frontend": "^6.5.1",
    "helmet": "^8.3.0",
    "hmpo-app": "^7.0.0",
    "hmpo-components": "^11.4.0",
    "hmpo-config": "^5.0.0",
    "hmpo-form-wizard": "^18.0.0",
    "hmpo-i18n": "^8.0.1",
    "hmpo-logger": "^9.0.0",
    "hmpo-model": "^7.0.1",
    "http-status-codes": "^2.3.0",
    "libphonenumber-js": "^1.13.15",
    "moment": "^2.31.0",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "chai": "^6.3.0",
    "express-session": "^1.19.0",
    "hmpo-stubber": "^4.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "open-cli": "^9.0.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-gherkin": "^4.0.0",
    "prettier-plugin-nunjucks": "^0.2.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.6",
    "sass": "^1.105.1",
    "shx": "^0.4.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
